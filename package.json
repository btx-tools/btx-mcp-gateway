{
  "name": "@btx-tools/mcp-gateway",
  "version": "0.2.0",
  "description": "MCP server framework with per-tool-call BTX service-challenge admission. Gate any agent tool behind chain-anchored proof-of-work. Companion to @btx-tools/challenges-sdk.",
  "author": "visitor-code <visitor@friction.market>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./example-tools": {
      "import": {
        "types": "./dist/example-tools/index.d.ts",
        "default": "./dist/example-tools/index.js"
      },
      "require": {
        "types": "./dist/example-tools/index.d.cts",
        "default": "./dist/example-tools/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "example:server": "tsx examples/stdio-server.ts",
    "example:client": "tsx examples/client-demo.ts",
    "prepublishOnly": "tsup"
  },
  "peerDependencies": {
    "@btx-tools/challenges-sdk": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@btx-tools/challenges-sdk": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  },
  "keywords": [
    "btx",
    "mcp",
    "model-context-protocol",
    "service-challenges",
    "ai-gateway",
    "agent",
    "agentic-ai",
    "admission-control",
    "rate-limit",
    "proof-of-work",
    "post-quantum"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btx-tools/btx-mcp-gateway.git"
  },
  "homepage": "https://github.com/btx-tools/btx-mcp-gateway#readme",
  "bugs": {
    "url": "https://github.com/btx-tools/btx-mcp-gateway/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.17"
  },
  "sideEffects": false
}
