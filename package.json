{
  "name": "@btx/mcp-gateway",
  "version": "0.0.1",
  "description": "MCP server reference implementation with per-tool-call BTX service-challenge admission. Companion to @btx/challenges-sdk.",
  "author": "visitor-code <visitor@friction.market>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "devDependencies": {
    "@btx/challenges-sdk": "workspace:*",
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "btx",
    "mcp",
    "model-context-protocol",
    "service-challenges",
    "ai-gateway",
    "agent",
    "proof-of-work"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btx-tools/btx-mcp-gateway.git"
  },
  "engines": {
    "node": ">=18"
  }
}
